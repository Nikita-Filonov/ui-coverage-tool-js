{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "declaration": true,
    "declarationDir": "dist",
    "allowSyntheticDefaultImports": true,
    "sourceMap": true,
    "strict": true,
    "types": ["node"]
  },
  "include": ["src", "tests/**/*.ts", "vitest.config.ts", "tsdown.config.ts"]
}
